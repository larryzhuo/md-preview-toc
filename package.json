  "version": "0.2.1",
  "publisher": "larryz7",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/larryzhuo/md-preview-toc.git"
  },
  "keywords": ["markdown", "preview", "toc", "table of contents", "outline"],
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "contributes": {
    "markdown.previewScripts": ["./media/toc.js", "./media/mermaid-fs.js"],
    "markdown.previewStyles": ["./media/toc.css", "./media/mermaid-fs.css"]
  }
}
